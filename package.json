{
  "name": "darkride",
  "version": "1.1.0",
  "description": "AI-powered mobile application reverse engineering and network traffic analysis toolkit",
  "license": "AGPL-3.0-only",
  "keywords": [
    "android",
    "ios",
    "reverse-engineering",
    "mobile-security",
    "frida",
    "mitmproxy",
    "wireguard",
    "adb",
    "scrcpy",
    "https-capture",
    "traffic-analysis",
    "apk-analysis",
    "automation",
    "ai-agent",
    "mcp",
    "anthropic",
    "self-hosted",
    "plugin-system"
  ],
  "main": "dist/backend/index.js",
  "engines": {
    "node": ">=22.15.0"
  },
  "bin": {
    "darkride": "./bin/darkride.js"
  },
  "workspaces": [
    "packages/*",
    "plugins/*"
  ],
  "scripts": {
    "dev": "npm run build -w @darkrideapp/plugin-sdk && concurrently \"tsx watch backend/index.ts\" \"vite\"",
    "clean": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\"",
    "build": "npm run clean && npm run build -w @darkrideapp/plugin-sdk && tsc && node scripts/copy-plugin-assets.js && node --max-old-space-size=4096 node_modules/vite/bin/vite.js build",
    "start": "node dist/backend/index.js",
    "typecheck": "npm run build -w @darkrideapp/plugin-sdk && tsc --noEmit",
    "test": "npm run typecheck && vitest run",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest watch",
    "test:frontend": "vitest run --config vitest.config.frontend.ts",
    "lint": "eslint backend/ shared/ plugins/ --ext .ts,.js",
    "db:generate": "drizzle-kit generate",
    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio",
    "db:repair": "node -e \"if(!process.env.DATABASE_PATH){console.error('Set DATABASE_PATH'); process.exit(1)}\" && sqlite3 \"$DATABASE_PATH\" < scripts/repair-skipped-migrations.sql"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.995.0",
    "@aws-sdk/lib-storage": "^3.1013.0",
    "@aws-sdk/s3-request-presigner": "^3.995.0",
    "@darkrideapp/plugin-sdk": "*",
    "@devicefarmer/minicap-prebuilt": "^2.7.3",
    "@devicefarmer/minitouch-prebuilt": "^1.3.0",
    "@grpc/grpc-js": "^1.14.4",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@node-rs/argon2": "^2.0.2",
    "@octokit/rest": "^22.0.1",
    "@types/dockerode": "^4.0.1",
    "@u4/minicap-prebuilt": "^1.1.2",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-web-links": "^0.12.0",
    "@xterm/xterm": "^6.0.0",
    "adm-zip": "^0.5.16",
    "android-emulator-webrtc": "^1.0.18",
    "archiver": "^7.0.1",
    "better-sqlite3": "^12.6.2",
    "cookie-parser": "^1.4.7",
    "dockerode": "^5.0.0",
    "drizzle-orm": "^0.45.2",
    "express": "^4.21.0",
    "google-play-scraper": "^10.1.2",
    "highlight.js": "^11.11.1",
    "http-proxy-agent": "^7.0.2",
    "https-proxy-agent": "^7.0.6",
    "isolated-vm": "^6.1.2",
    "jose": "^5.9.0",
    "lucide-react": "^0.564.0",
    "multer": "^2.1.1",
    "node-pty": "^1.1.0",
    "nodemailer": "^8.0.4",
    "pbf": "^4.0.1",
    "qrcode": "^1.5.4",
    "react-markdown": "^10.1.0",
    "recharts": "^3.7.0",
    "rehype-highlight": "^7.0.2",
    "remark-gfm": "^4.0.1",
    "semver": "^7.7.0",
    "sharp": "^0.34.5",
    "socks": "^2.8.7",
    "socks-proxy-agent": "^8.0.5",
    "typescript": "^5.7.0",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.59.1",
    "@testing-library/jest-dom": "^6.6.0",
    "@testing-library/react": "^16.1.0",
    "@types/adm-zip": "^0.5.7",
    "@types/archiver": "^7.0.0",
    "@types/better-sqlite3": "^7.6.12",
    "@types/cookie-parser": "^1.4.10",
    "@types/express": "^4.17.21",
    "@types/mime-types": "^3.0.1",
    "@types/multer": "^2.1.0",
    "@types/nodemailer": "^7.0.11",
    "@types/pbf": "^3.0.5",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/semver": "^7.7.0",
    "@types/supertest": "^6.0.2",
    "@types/ws": "^8.5.13",
    "@typescript-eslint/parser": "^8.58.2",
    "@vitejs/plugin-react": "^4.3.0",
    "@vitest/coverage-v8": "^3.2.0",
    "concurrently": "^9.1.0",
    "drizzle-kit": "^0.31.0",
    "eslint": "^8.57.1",
    "eslint-plugin-local": "file:./eslint-rules",
    "jsdom": "^25.0.0",
    "monaco-editor": "^0.52.0",
    "playwright": "^1.58.2",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-router-dom": "^7.1.0",
    "supertest": "^7.0.0",
    "tsx": "^4.19.0",
    "vite": "^6.0.0",
    "vitest": "^3.2.0"
  },
  "overrides": {
    "fast-xml-parser": "^5.3.8",
    "esbuild": "^0.25.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/DarkRideApp/DarkRide.git"
  },
  "homepage": "https://darkride.app",
  "bugs": {
    "url": "https://github.com/DarkRideApp/DarkRide/issues"
  }
}
