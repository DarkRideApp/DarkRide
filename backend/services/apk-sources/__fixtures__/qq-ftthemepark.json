{"ret":0,"err_msg":"","has_next":0,"offset":"0","record_key_type":0,"app_detail_records":{"com.hytch.ftthemepark":{"app_info":{"app_id":"42256331","name":"方特旅游","english_name":"","package_name":"com.hytch.ftthemepark","author":"方特国际旅行社有限公司","cp_id":2133513,"category_id":108,"category_name":"旅游","check_level":40,"cur_apk_id":"52627823","desc":"【方特旅游初印象】\n“方特旅游”是华强方特集团为旗下方特系列主题乐园量身打造的官方智慧游园APP，为您提供方特门票年卡预订、酒店预订、乐园营业时间、项目等候时间、地图导航、尊享服务、云排队、在线点餐、停车缴费、玩法攻略、活动资讯等诸多功能，助您轻轻松松，欢乐畅游。\n\n【游园必备功能】\n1.门票预订：线上购买门票、套票、优惠票及年卡，无需取票，快速入园。\n2.酒店预订：方特酒店官方直订，有保障更省心。\n3.乐园营业时间：查看乐园开放时间，提前知晓项目演出安排。\n4.游园攻略：必读攻略、园区活动、路线推荐等超全面玩法推荐，省时省力玩转方特。\n5.地图导航：项目、演出、餐饮、商店、游客服务、洗手间六大地图信息，实时导航找路游园更轻松。\n6.项目等候时间：快速查看排队等候时间，灵活安排游玩行程。\n7.线上租赁：代步车等提前预订，随需随用，方便快捷。\n8.尊享服务：定制服务高效游园，尊享体验尽享欢乐。\n9.云排队：火爆项目无需现场苦等，边玩边等更轻松。\n10.在线点餐：支持立即点餐或预约点餐，到店即享美食。\n11.游玩提醒：关注项目设置提醒，开场立即通知，精彩不再错过！","publish_time":1458116919,"create_time":1458116919,"update_time":1781497101,"self_developed":1,"is_tencent_app":0,"icon_timestamp":1458116916,"status":0,"tag":"24001016;","alias":"方特旅游;","download_cnt_total":"1752976","score_cnt5_total":"464","score_cnt4_total":"18","score_cnt3_total":"0","score_cnt2_total":"0","score_cnt1_total":"2","download_cnt_pc_total":"0","install_cnt_total":"0","download_cnt_mbtotal":"0","tag_new":"","ieg_tag":0,"keyword":"","tag_name":"","parent_category_id":-1,"involve_privacy":0,"download_week":"593","is_official":0,"mini_video_url":"","mini_video_orientation":"","mini_video_snap_shot":"","mini_video_src_id":0,"mini_video_src_name":"","mini_video_src_logo":"","mini_video_src_url":"","is_tencent_yun":0,"minner_data":{"cloudGameUV":"0","downloadCnt":"1752976","isOfficial":"0","manualSecurityTags":"7","openAppType":"1","privacyAgreement":"https://image.fangte.com/UploadFiles/H5/RichText/index.html?id=0C91DCD9E2EA43B17E852D7FDBF27BB7&dir=Agreement&style=comm-notice","qualityScore":"70","systemSecurityTags":"1"},"editor_score":0,"open_app_id":"1104789793","category_idnew":24,"category_name_new":"旅游出行","suitable_a