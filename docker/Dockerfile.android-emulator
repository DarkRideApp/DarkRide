# Image: ghcr.io/darkrideapp/docker-android:<android-version>
#
# Strategy: thin layer on top of budtmo/docker-android. budtmo handles
# the heavy lift (Android emulator, scrcpy server, xvfb, noVNC). We add:
#   - wireguard-go (via apt) for the WireGuard capture tunnel
#   - a darkride entrypoint that waits for adbd to bind before exiting
#
# The mitmproxy CA cert is NOT baked in — it's regenerated per-install
# and pushed at runtime via `adb push` + remount /system rw, same as the
# physical-device path. budtmo's image is a userdebug build so this works.
#
# Frida server is intentionally not pre-baked in v1. Plugins needing TLS
# pinning bypass can install it themselves; the next image revision will
# add it once a real consumer is in place.

ARG BUDTMO_VERSION=14.0
FROM budtmo/docker-android:emulator_${BUDTMO_VERSION}

USER root

# wireguard-go from apt — works on Ubuntu/Debian, which budtmo's base is.
RUN apt-get update \
    && apt-get install -y --no-install-recommends wireguard-go iproute2 \
    && rm -rf /var/lib/apt/lists/*

COPY entrypoint.sh /darkride-entrypoint.sh
RUN chmod +x /darkride-entrypoint.sh

ENTRYPOINT ["/darkride-entrypoint.sh"]
