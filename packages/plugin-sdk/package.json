{
  "name": "@darkrideapp/plugin-sdk",
  "version": "1.8.0",
  "description": "Plugin authoring SDK for DarkRide. Re-exports definePlugin and all plugin types.",
  "license": "AGPL-3.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/DarkRideApp/DarkRide.git",
    "directory": "packages/plugin-sdk"
  },
  "homepage": "https://github.com/DarkRideApp/DarkRide/tree/main/packages/plugin-sdk#readme",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./utils": {
      "types": "./dist/utils/index.d.ts",
      "default": "./dist/utils/index.js"
    },
    "./test-utils": {
      "types": "./dist/test-utils/index.d.ts",
      "default": "./dist/test-utils/index.js"
    },
    "./react": {
      "types": "./dist/react/index.d.ts",
      "default": "./dist/react/index.js"
    }
  },
  "files": ["dist/", "README.md", "LICENSE"],
  "scripts": {
    "build": "tsc -p tsconfig.json && tsc -p tsconfig.react.json",
    "watch": "tsc -p tsconfig.json -w",
    "clean": "rm -rf dist",
    "test": "vitest run"
  },
  "publishConfig": {
    "access": "public"
  },
  "peerDependencies": {
    "better-sqlite3": "*",
    "drizzle-orm": "*",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-router-dom": "^7.0.0",
    "lucide-react": "^0.564.0",
    "monaco-editor": "^0.52.0"
  },
  "peerDependenciesMeta": {
    "react":            { "optional": true },
    "react-dom":        { "optional": true },
    "react-router-dom": { "optional": true },
    "lucide-react":     { "optional": true },
    "monaco-editor":    { "optional": true }
  },
  "devDependencies": {
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-router-dom": "^7.0.0",
    "lucide-react": "^0.564.0",
    "typescript": "^5.0.0",
    "vitest": "^3.2.0"
  }
}
