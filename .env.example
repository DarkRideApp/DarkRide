PORT=3000

# Bind address. 127.0.0.1 restricts to local machine (recommended for dev).
# Setting HOST=0.0.0.0 exposes the server to all network interfaces.
# Multi-user auth is built in (argon2id, scopes, sessions, CSRF, API keys,
# optional OAuth) — but before binding non-locally, complete the first-boot
# admin claim and review SECURITY.md for known gaps (static-file routes,
# plaintext secrets at rest, broad backup endpoint, no CSP headers yet).
HOST=127.0.0.1

DATABASE_PATH=./data/darkride.db
SCREENSHOT_PATH=./data/screenshots
PRUNE_DAYS=7

# DATA_ROOT=./data                # Root directory for runtime data (override to use a different disk/mount)
# NODE_ENV=production             # Production mode (serves built UI, disables dev features)
# DEBUG_LOGS=1                    # Enable verbose logging

# TRUST_PROXY=1                   # Set when behind a reverse proxy (e.g. Traefik). Values: hop count, 'loopback', subnet list.
# DARKRIDE_PLUGINS=kitchen-sink   # Comma-separated plugin allow-list. Loads only those + their dependencies.
# DARKRIDE_PLUGIN_DIRS=/path/one:/path/two   # Path-delimited extra plugin scan dirs (':' on Linux/macOS, ';' on Windows)

# WG_SERVER_IP=192.168.1.100      # Override WireGuard server IP (auto-detected by default)
# MITMPROXY_DATA=./data/mitm      # mitmproxy working directory

# First-run admin bootstrap (ignored once any admin exists):
# DARKRIDE_BOOTSTRAP_ADMIN_USERNAME=admin
# DARKRIDE_BOOTSTRAP_ADMIN_PASSWORD=change-me
